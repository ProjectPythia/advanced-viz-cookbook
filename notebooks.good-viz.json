mn":1},"end":{"line":9,"column":1}},"key":"I4ZI1SSnea"}],"key":"OlS7y99xHp"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"For example, from ","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"IOP9z21l1c"},{"type":"link","url":"https://matplotlib.org/stable/tutorials/colors/colormaps.html","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Matplotlib’s Choosing a Colormap documentation","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"EIwGhyjPEA"}],"urlSource":"https://matplotlib.org/stable/tutorials/colors/colormaps.html","key":"Qdl8e1x4R9"},{"type":"text","value":" here are some “good” colormaps:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"NTbkCzV4Nm"}],"key":"EReSBWTmm8"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"image","url":"/advanced-viz-cookbook/build/3d9b151c564500568152b043aa3de01d.png","alt":"Matplotlib Logo","key":"L1ZFj9wRyT","urlSource":"https://matplotlib.org/stable/_images/sphx_glr_colormaps_016_2_00x.png"}],"key":"fYrIkn4tWS"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"And here are miscellaneous colormaps:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"GyTyaZpqPR"}],"key":"iHvFVh99rO"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"image","url":"/advanced-viz-cookbook/build/068b075c76b19409c73f88c3bce70fbc.png","alt":"Matplotlib Logo","key":"efoQn1afPR","urlSource":"https://matplotlib.org/stable/_images/sphx_glr_colormaps_021_2_00x.png"}],"key":"Nw9gGUhADm"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Looking at the colors in grayscale helps to understand why we might prefer a sequentially ordered colormap. Some grayscale values are duplicated and the reader will not know if it is a high or low value.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"SyWFsgY8td"}],"key":"M6Z04paXiw"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Another consideration that can help those who are visually impaired is to make sure your figure captions are descriptive. Use words to paint a picture of what is displayed, not just the conclusions you want the reader to reach.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"NMkwBuOokn"}],"key":"bijm8HNYgw"}],"key":"BdVlCQ5IgF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Misleading Visualizations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mgNDlW0j0t"}],"identifier":"misleading-visualizations","label":"Misleading Visualizations","html_id":"misleading-visualizations","implicit":true,"key":"h1zkp8zQac"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The scales or colors we choose to use for data visualization affect how people interpret figures. You should strive to make your visualizations as accurate and as informative as possible. Here are some examples that demonstrate just how different a figure can look based on these choices you make. Do not intentionally mislead your audience!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LJgr2xTra8"}],"key":"MLufBWcuvV"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Perhaps the most common data visualization manipulation is to change the Y-scale. If a plot does not begin at 0, small changes in magnitude can be exaggerated. Similarly a logarithmic scale will amplify changes. This is not always disingenuous, sometimes these changes are what you want to highlight, the pattern you want to draw attention to. Just make sure it is appropriate for your use case and documented. Alternatively, extending the Y-axis too large has the opposite affect and smooths out the differences in data.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xw5fRwsiLn"}],"key":"Ycz4XjQEiM"}],"key":"o28lb03MWp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = [1, 2, 3, 4, 5]\ny = [1101, 1011, 1111, 1070, 1050]\n\n\nfig, (ax1, ax2, ax3, ax4) = plt.subplots(4)\nfig.tight_layout()\n\nax1.bar(x,y)\nax1.set_title(\"Default Y-Scale Starts at 0\")\n\nax2.bar(x,y)\nax2.set_ylim(1000)\nax2.set_title(\"Y-Scale Starts at 1000\")\n\nax3.bar(x,y)\nax3.set_yscale(\"log\")\nax3.set_title(\"Y-Scale is Logarithmic\");\n\nax4.bar(x,y)\nax4.set_ylim(0, 2000)\nax4.set_title(\"Y-Scale is Extended\");","key":"UDcr7Ow6Wq"},{"type":"output","id":"JQnX8fUwQNodzjs-WEh1C","data":[],"key":"AREaaQTvBD"}],"key":"rs7bfPeyfJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Other examples of data visualization manipulation include improper scaling, cherry picking a small non-representative subset of the data to display, displaying pie charts at a slant (pie charts are hard to interpet as is), and using unexpected colormaps.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VuYBI3XmGm"}],"key":"tNwmbEXY4r"}],"key":"nPcKwof1O2"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iPhFJrOSEt"}],"key":"BuY5GDngpF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pNiDSjwKC4"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"ud5sZYCS65"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"It is important to have accurate, engaging, and representative data visualization to accumpany your research, both for data exploration as part of the scientific process, for communication of results, and education/outreach efforts. Visually we pick up on patterns that statistics alone may not convey. However, an over reliance on data visualization can make science less accessible to those with vision disabilities. It is important to be cognizant of the patterns our minds pick up, be it based on color or y-axis scaling, so that we can avoid misleading our audience and more accurately convey the narrative inherent to the data.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"icbYOp3Ced"}],"key":"sPhOj5UEak"},{"type":"heading","depth":3,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"What’s next?","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"vat0YTFUQo"}],"identifier":"whats-next","label":"What’s next?","html_id":"whats-next","implicit":true,"key":"Rlg9MM6jGD"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Let’s break down the different components of data visualization in ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"dFzADvw8IR"},{"type":"link","url":"/notebooks/plot-elements","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Plot Elements","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"E3Deaw0TDs"}],"urlSource":"3-plot-elements","dataUrl":"/notebooks.plot-elements.json","internal":true,"protocol":"file","key":"xSOGdDJoKo"},{"type":"text","value":".","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"rTRZmOErvI"}],"key":"P76KCiI3SL"}],"key":"t0nH4QFaWI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Resources and references","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rgx08ND9Kn"}],"identifier":"resources-and-references","label":"Resources and references","html_id":"resources-and-references","implicit":true,"key":"rAC0dqGazV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://www.research.autodesk.com/publications/same-stats-different-graphs/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Autodesk","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tSo1gcY80G"}],"urlSource":"https://www.research.autodesk.com/publications/same-stats-different-graphs/","key":"qg6iyjZhXX"}],"key":"CcleJV3NLh"}],"key":"uGBQPQ8DOA"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://matplotlib.org/stable/tutorials/colors/colormaps.html","position":{"start":{"line":4,"column":1},"end":{