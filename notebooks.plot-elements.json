lorbars","html_id":"colorbars","implicit":true,"key":"hTaCqkgPYu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"While legends are more appropriate for line or bar plots, colorbars are most commonly used for contour plots and sometimes to apply a third level of dimension to a scatter plot.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xG7LKGAFcC"}],"key":"YXeoEP5ZFD"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Let’s shift our example to better demonstrate a colorbar by workign with a filled contour plot:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fbPJZklkQI"}],"key":"zP9pXqCkNr"}],"key":"TdSsvL1pll"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Generate dummy data\ndata = [[1, 4, 5, 6, 8.2],\n        [9, 8.4, 10, 10.6, 9.7],\n        [4.4, 5, 0, 6.6, 1.4],\n        [4.6, 5.2, 1.5, 7.6, 2.4]]\n\n# Convert data into type xarray.DataArray\ndata = xr.DataArray(data,\n                    dims=[\"lat\", \"lon\"],\n                    coords=dict(lat=np.arange(4), lon=np.arange(5)))\n\ndata","key":"Z8ZQpCHC8P"},{"type":"output","id":"BHty2IwXoNGGcjbLN-dv3","data":[],"key":"N52iteqCh8"}],"key":"oFfhnapFHt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(9.5, 8))\nax = plt.axes()\n\npcm = ax.contourf(data,cmap='viridis')\n\nax.set_title(\"Dummy Data\")\nax.set_xlabel(\"Longitude (\\N{DEGREE SIGN})\")\nax.set_ylabel(\"Latitude (\\N{DEGREE SIGN})\")\n\nfig.colorbar(pcm,ax=ax);","key":"Z64WJj6Pj6"},{"type":"output","id":"LnI3Bl8d3EZXukNjJX_tj","data":[],"key":"drEajVkB39"}],"key":"kf2hHyIBMV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"l